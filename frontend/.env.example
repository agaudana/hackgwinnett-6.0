# Unset (default): call the backend at /api and fall back to a clearly labeled example if it can't be reached.
# true: always use the built-in example (no backend needed).
# false: always call the backend and show an error if it can't be reached.
VITE_USE_MOCK=

# Backend URL for production builds (e.g. https://healthlens-api.onrender.com). Leave empty for local dev.
VITE_API_BASE=
