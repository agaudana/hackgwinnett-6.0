# Copy to backend/.env and fill in. Never commit .env.
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Leave empty to run in DEMO MODE (clearly labeled sample AI answers).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Leave empty for api.openai.com. For Bedrock's OpenAI-compatible endpoint, e.g.
# https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1
OPENAI_BASE_URL=

# Set to 1 to force DEMO MODE even with a key (escape hatch if the API flakes on stage).
MOCK_AI=
